# Copy to .env and fill in. Never commit .env.

# Groq API key (https://console.groq.com). Required: the agents call Llama 3.3 70B through Groq.
GROQ_API_KEY=...

# Optional: another Groq chat model
# GROQ_MODEL=llama-3.3-70b-versatile

# Database. The defaults match docker-compose.yml (root, no password, port 3308).
# DB_HOST=localhost
# DB_PORT=3308
# DB_USER=root
# DB_PASSWORD=
# DB_NAME=ecommerce

# Flask
# PORT=5000
# FLASK_DEBUG=0
